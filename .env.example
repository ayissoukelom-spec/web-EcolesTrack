# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Auth simulation for local development/testing only; rejected when NODE_ENV=production.
ALLOW_SIMULATED_AUTH=false

# JWT Configuration
# JWT_SECRET: secret used to sign and verify JSON Web Tokens.
# REQUIRED in production — store in a secrets manager, do not commit.
JWT_SECRET="YOUR_JWT_SECRET"

# JWT issuer and audience used to validate incoming tokens (recommended)
JWT_ISSUER="ecoletrack"
JWT_AUDIENCE="ecoletrack-api"

# JWT expiry configuration for access tokens.
# Example: 1h, 15m, 30m.
JWT_EXPIRES_IN="1h"

# File storage configuration
# local = store files under uploads/ in the app filesystem (development only)
# s3 = store files in an S3-compatible persistent object store (required in production)
# Production startup fails unless FILE_STORAGE_PROVIDER=s3 and the S3 config is valid.
FILE_STORAGE_PROVIDER="local"
UPLOADS_DIR=""

# S3-compatible storage (required when FILE_STORAGE_PROVIDER=s3)
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
