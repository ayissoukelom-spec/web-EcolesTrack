{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*",
    "src/**/*.d.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "scripts/**",
    "test/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "app-transformed.tsx",
    "dashboard-transformed.tsx",
    "tmp*.ts",
    "tmp*.tsx",
    "tmp*.mts",
    "tmp*.mjs",
    "tmp*.js",
    "tmp-*.ts",
    "tmp-*.tsx",
    "tmp-*.mts",
    "tmp-*.mjs",
    "tmp-*.js"
  ]
}
